# API runtime settings. Never put real secrets in this file.
APP_ENV=production
PORT=8081
LISTEN_HOST=127.0.0.1
DB_PATH=/var/lib/numerix/numerix.db
# Required in production: openssl rand -hex 32.
JWT_SECRET=
# Required in production and shared with the admin app: openssl rand -hex 32.
ADMIN_API_TOKEN=
FEATURE_WELCOME_GIFT=false
TRUST_PROXY=true
ACCESS_TTL_SECONDS=900
CHILD_TTL_SECONDS=28800
REFRESH_TTL_SECONDS=2592000
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=256
RATE_LIMIT_IP_PER_MIN=600
PPROF=false
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_MONTHLY_CAP=0
MONGODB_URI=
MONGODB_DB=numerix
# Required only when MONGODB_URI is set; openssl rand -hex 32.
MONGO_PSEUDO_SECRET=
ASSET_BASE_URL=/assets
MEDIA_DIR=/var/lib/numerix/feed-media
MEDIA_BASE_URL=/feed-media
ALLOWED_ORIGINS=https://app.YOURDOMAIN
ADMIN_ORIGIN=https://admin.YOURDOMAIN
# Set both passkey values to the app hostname/origin, or leave both empty to disable passkeys.
WEBAUTHN_RP_ID=app.YOURDOMAIN
WEBAUTHN_RP_NAME=Numerix
WEBAUTHN_ORIGINS=https://app.YOURDOMAIN
# Optional story writer. Keep blank/off unless the owner explicitly enables it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DRAFT_MODEL=
NARRATOR_MODEL=

# Shrink the media files once at start-up (needs ffmpeg; skipped when missing)
MEDIA_OPTIMIZE=true
FFMPEG_BIN=ffmpeg
