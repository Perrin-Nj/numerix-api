# The web and admin apps, built by the SAME script production uses (scripts/release.sh) and run with the same node.
# Build context is the frontend repo.
FROM node:22-bookworm AS build
RUN corepack enable
WORKDIR /src
COPY . .
# Windows checkouts carry CRLF; it breaks sourcing config/env/*.env inside the Linux build.
RUN sed -i 's/$//' config/env/*.env scripts/*.sh
RUN pnpm install --frozen-lockfile && (cd admin && npm ci)
RUN bash scripts/release.sh web local && bash scripts/release.sh admin local \
 && mkdir -p /out/web /out/admin \
 && tar -xzf dist/web.tgz -C /out/web && tar -xzf dist/admin.tgz -C /out/admin

FROM node:22-bookworm-slim AS web
WORKDIR /app
COPY --from=build --chown=node:node /out/web /app
USER node
CMD ["node", "server.js"]

FROM node:22-bookworm-slim AS admin
WORKDIR /app
COPY --from=build --chown=node:node /out/admin /app
USER node
CMD ["node", "server.js"]
