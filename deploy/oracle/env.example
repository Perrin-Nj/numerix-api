# Copy to /etc/numerix/api.env on the VM (setup.sh does it) and fill in. Never commit real values.
# STAGING AND PRODUCTION BOTH USE APP_ENV=production on purpose: the strict checks (secret length, https origins,
# Secure cookies, JSON logs) are the point of rehearsing on staging. The two environments differ only in the values below.
APP_ENV=production
PORT=8081
# Only Caddy and the web/admin servers on this VM may reach the API.
LISTEN_HOST=127.0.0.1
DB_PATH=/var/lib/numerix/numerix.db
# openssl rand -hex 32  (different value on staging and production)
JWT_SECRET=
# openssl rand -hex 32  (the same value goes into /etc/numerix/admin.env on the same VM)
ADMIN_API_TOKEN=
# Production example. Staging uses https://staging-admin.example.ca etc.
ADMIN_ORIGIN=https://admin.example.ca
ALLOWED_ORIGINS=https://app.example.ca
# Passkeys: the RP id is the bare host of the web app (no scheme, no port); the origin is the full https origin.
WEBAUTHN_RP_ID=app.example.ca
WEBAUTHN_ORIGINS=https://app.example.ca
WEBAUTHN_RP_NAME=Numerix
# Behind Caddy the real client IP arrives in X-Forwarded-For (the web app forwards it, the API is bound to 127.0.0.1).
TRUST_PROXY=true
FEATURE_WELCOME_GIFT=false
# Discover media (200 files, docs/FEED_MEDIA.md). Copy seed/feed-media here once per release.
MEDIA_DIR=/var/lib/numerix/feed-media
# Optional story writer; without these the canned stories are used.
ANTHROPIC_API_KEY=
NARRATOR_MODEL=
# Optional MongoDB Atlas copy of personal bests, family board and anonymised stats (docs/MONGO_SYNC.md).
# Leave MONGODB_URI empty to keep it off. When set, MONGO_PSEUDO_SECRET is required (openssl rand -hex 32).
# Never change MONGO_PSEUDO_SECRET later: it would turn every pseudonym into a new one.
MONGODB_URI=
MONGODB_DB=numerix
MONGO_PSEUDO_SECRET=
# Optional: where clients fetch images (the web app rewrites /assets/* to this API). Default /assets.
ASSET_BASE_URL=
