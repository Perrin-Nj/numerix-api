# Copy to /etc/numerix/api.env on the VM and fill in. Never commit real values.
APP_ENV=production
PORT=8081
DB_PATH=/var/lib/numerix/numerix.db
# openssl rand -hex 32
JWT_SECRET=
ADMIN_API_TOKEN=
ADMIN_ORIGIN=https://numerix-admin.vercel.app
ALLOWED_ORIGINS=https://numerix-web-snowy.vercel.app
# Passkeys need the real site domain (no scheme, no port) and the exact origin of the web app.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=https://numerix-web-snowy.vercel.app
WEBAUTHN_RP_NAME=Numerix
# Behind Caddy the real client IP arrives in X-Forwarded-For.
TRUST_PROXY=true
FEATURE_WELCOME_GIFT=false
# Optional story writer; without these the canned stories are used.
ANTHROPIC_API_KEY=
NARRATOR_MODEL=
# Optional MongoDB Atlas copy of personal bests, family board and anonymised stats (docs/MONGO_SYNC.md).
# Leave MONGODB_URI empty to keep it off. When set, MONGO_PSEUDO_SECRET is required (openssl rand -hex 32).
# Never change MONGO_PSEUDO_SECRET later: it would turn every pseudonym into a new one.
MONGODB_URI=
MONGODB_DB=numerix
MONGO_PSEUDO_SECRET=
