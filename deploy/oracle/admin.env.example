# /etc/numerix/admin.env (admin app). All four are secrets or point at secrets. Never commit real values.
# Platform base URL, no /v1. Same VM, so it stays on localhost.
PLATFORM_API_URL=http://127.0.0.1:8081
# Same value as ADMIN_API_TOKEN in /etc/numerix/api.env.
ADMIN_API_TOKEN=
# Login password of the admin app (8+ characters, long and random).
ADMIN_PASSWORD=
# openssl rand -hex 32 (signs the admin session cookie)
ADMIN_SESSION_SECRET=
