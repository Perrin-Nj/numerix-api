[Unit]
Description=Numerix API
After=network-online.target
Wants=network-online.target

[Service]
User=numerix
Group=numerix
# Secrets and settings live in /etc/numerix/api.env, never in the repo.
EnvironmentFile=/etc/numerix/api.env
ExecStart=/opt/numerix/api
Restart=always
RestartSec=2
# SQLite file lives here; the API listens only on localhost, Caddy faces the internet.
WorkingDirectory=/var/lib/numerix
# Hardening: no new privileges, read-only system, write only to the data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/numerix
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
