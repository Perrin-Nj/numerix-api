# Staging admin app environment. Never reuse production credentials.
PLATFORM_API_URL=http://127.0.0.1:8081
# Required, at least 16 characters; generate once and copy same value to staging api.env.
ADMIN_API_TOKEN=
# Required, at least 8 characters; use a unique strong password.
ADMIN_PASSWORD=
# Required, at least 32 characters; openssl rand -hex 32.
ADMIN_SESSION_SECRET=
