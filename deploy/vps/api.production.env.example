# Production API. Copy to /etc/numerix/api.env and replace YOURDOMAIN. Never commit real secrets.
# APP_ENV and LISTEN_HOST are required production values.
APP_ENV=production
PORT=8081
LISTEN_HOST=127.0.0.1
DB_PATH=/var/lib/numerix/numerix.db
# Required: openssl rand -hex 32.
JWT_SECRET=
# Required; generate once and copy the same value to admin.env.
ADMIN_API_TOKEN=
# Optional feature flag; false until content and owner approval.
FEATURE_WELCOME_GIFT=false
# Required behind Caddy so client IP checks use the trusted proxy.
TRUST_PROXY=true
# Optional limits; defaults are safe to retain.
ACCESS_TTL_SECONDS=900
CHILD_TTL_SECONDS=28800
REFRESH_TTL_SECONDS=2592000
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=256
RATE_LIMIT_IP_PER_MIN=600
# Must stay false in production.
PPROF=false
# Optional legacy LLM settings; keep disabled unless configured.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_MONTHLY_CAP=0
# Optional Mongo mirror; leave URI empty for SQLite-only operation.
MONGODB_URI=
MONGODB_DB=numerix
# Required only if Mongo is enabled; openssl rand -hex 32.
MONGO_PSEUDO_SECRET=
# Optional path/URL overrides; defaults shown.
ASSET_BASE_URL=/assets
MEDIA_DIR=/var/lib/numerix/feed-media
# Shrink the media files once at start-up (needs ffmpeg on the VM; skipped when it is missing)
MEDIA_OPTIMIZE=true
FFMPEG_BIN=ffmpeg
MEDIA_BASE_URL=/feed-media
# Required HTTPS origins for the production hosts.
ALLOWED_ORIGINS=https://app.YOURDOMAIN
ADMIN_ORIGIN=https://admin.YOURDOMAIN
# Required together to enable passkeys; use the production app host.
WEBAUTHN_RP_ID=app.YOURDOMAIN
WEBAUTHN_RP_NAME=Numerix
WEBAUTHN_ORIGINS=https://app.YOURDOMAIN
# Optional Anthropic story writer; leave blank/off at launch.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DRAFT_MODEL=
NARRATOR_MODEL=
