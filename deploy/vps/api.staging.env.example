# Staging API. Copy to /etc/numerix/api.env and replace YOURDOMAIN. Never commit real secrets.
# Staging runs strict production validation with separate credentials and data.
APP_ENV=production
PORT=8081
LISTEN_HOST=127.0.0.1
DB_PATH=/var/lib/numerix/numerix.db
# Required: openssl rand -hex 32; do not reuse production.
JWT_SECRET=
# Required; generate once and copy the same value to staging admin.env.
ADMIN_API_TOKEN=
FEATURE_WELCOME_GIFT=false
TRUST_PROXY=true
ACCESS_TTL_SECONDS=900
CHILD_TTL_SECONDS=28800
REFRESH_TTL_SECONDS=2592000
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=256
RATE_LIMIT_IP_PER_MIN=600
PPROF=false
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_MONTHLY_CAP=0
# Optional Mongo mirror; leave disabled for staging unless explicitly required.
MONGODB_URI=
MONGODB_DB=numerix
# Required only if Mongo is enabled; openssl rand -hex 32.
MONGO_PSEUDO_SECRET=
ASSET_BASE_URL=/assets
MEDIA_DIR=/var/lib/numerix/feed-media
MEDIA_BASE_URL=/feed-media
ALLOWED_ORIGINS=https://staging-app.YOURDOMAIN
ADMIN_ORIGIN=https://staging-admin.YOURDOMAIN
WEBAUTHN_RP_ID=staging-app.YOURDOMAIN
WEBAUTHN_RP_NAME=Numerix Staging
WEBAUTHN_ORIGINS=https://staging-app.YOURDOMAIN
# Optional story writer; keep disabled unless explicitly configured.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DRAFT_MODEL=
NARRATOR_MODEL=
