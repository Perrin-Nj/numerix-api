# /etc/numerix/admin.env (admin app). Never commit real secrets.
# Platform base URL, no /v1. HTTPS is required except for this trusted loopback API.
PLATFORM_API_URL=http://127.0.0.1:8081
# Required, at least 16 characters; same value as ADMIN_API_TOKEN in api.env.
ADMIN_API_TOKEN=
# Required, at least 8 characters; use a unique strong password.
ADMIN_PASSWORD=
# Required, at least 32 characters; openssl rand -hex 32.
ADMIN_SESSION_SECRET=
